# =============================================================================
# Khedut App — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Allowed CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL
# Full connection string — used by pg Pool and node-pg-migrate
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://khedut_user:change_me@localhost:5432/khedut_db

# -----------------------------------------------------------------------------
# MongoDB
# Used by Mongoose for AI/conversation data only
# -----------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/khedut_db

# -----------------------------------------------------------------------------
# JWT — Access Token
# Must be at least 32 characters. Must NOT equal JWT_REFRESH_SECRET.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_random_string_of_at_least_32_chars_access
JWT_ACCESS_EXPIRES_IN=15m

# -----------------------------------------------------------------------------
# JWT — Refresh Token
# Must be at least 32 characters. Must NOT equal JWT_ACCESS_SECRET.
# -----------------------------------------------------------------------------
JWT_REFRESH_SECRET=replace_with_a_different_random_string_of_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Bcrypt
# Cost factor — 12 is recommended for production
# -----------------------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12

# -----------------------------------------------------------------------------
# Rate Limiting
# WINDOW_MS = rolling window in milliseconds (900000 = 15 minutes)
# MAX_REQUESTS = max requests per IP per window
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
